# ─────────────────────────────────────────────────────────────────────────────
# Telegram bot
# ─────────────────────────────────────────────────────────────────────────────
# Get a fresh token from @BotFather ( /revoke then /token ). NEVER commit the real one.
BOT_TOKEN=123456:REPLACE_ME
# Telegram user id of the initial owner (numeric). Seeded on first boot.
OWNER_ID=890701906

# ─────────────────────────────────────────────────────────────────────────────
# Web / webhook  (Render gives you https://<service>.onrender.com)
# ─────────────────────────────────────────────────────────────────────────────
WEBHOOK_BASE=https://your-service.onrender.com
# Random string; also sent to Telegram as secret_token and checked on every update.
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Random string used to sign short-lived Mini App session tokens.
SESSION_SECRET=change-me-to-another-long-random-string
# Public URL of the Mini App (defaults to ${WEBHOOK_BASE}/app if left blank).
WEBAPP_URL=

# Set to 1 for LOCAL development to use long-polling instead of a webhook.
USE_POLLING=0
# Port the web server binds to (Render injects PORT automatically).
PORT=8080

# ─────────────────────────────────────────────────────────────────────────────
# Database
#   local dev default (SQLite, file under ./data):
#     sqlite+aiosqlite:///./data/bot.db
#   production (free persistent Postgres, e.g. Neon / Supabase):
#     postgresql+asyncpg://user:pass@host/dbname
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/bot.db

# ─────────────────────────────────────────────────────────────────────────────
# Language
# ─────────────────────────────────────────────────────────────────────────────
DEFAULT_LANGUAGE=uz

# ─────────────────────────────────────────────────────────────────────────────
# AI backend  (all optional — if none is configured, AI features are disabled
# and the rest of the bot keeps working)
#
#   AI_PROVIDER / AI_FALLBACK: one of  groq | openai | gemini | ollama
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER=groq
AI_FALLBACK=

# OpenAI-compatible endpoint (covers Groq, OpenRouter, local llama.cpp / LM Studio,
# and Ollama's /v1). Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Google Gemini (free tier). Supports homework photos (vision).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Self-hosted Ollama (native API). Example: http://localhost:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=llama3.1

# Per-user AI calls allowed per rolling hour.
AI_RATE_PER_HOUR=20
# Max homework image upload size (MB).
MAX_UPLOAD_MB=8
